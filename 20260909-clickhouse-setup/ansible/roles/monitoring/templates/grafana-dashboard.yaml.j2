apiVersion: v1
kind: ConfigMap
metadata:
  name: grafana-clickhouse-lab
  namespace: {{ monitoring_namespace }}
  labels:
    grafana_dashboard: "1"
data:
  clickhouse-lab.json: |
    {
      "annotations": { "list": [] },
      "editable": true,
      "fiscalYearStartMonth": 0,
      "graphTooltip": 1,
      "id": null,
      "links": [],
      "panels": [
        {
          "id": 1,
          "title": "ClickHouse scrape (up)",
          "type": "stat",
          "gridPos": { "h": 4, "w": 8, "x": 0, "y": 0 },
          "targets": [{ "expr": "up{job=\"clickhouse-http\"}", "refId": "A" }],
          "fieldConfig": { "defaults": { "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": 0 }, { "color": "green", "value": 1 }] } }, "overrides": [] }
        },
        {
          "id": 2,
          "title": "Keeper scrape (up)",
          "type": "stat",
          "gridPos": { "h": 4, "w": 8, "x": 8, "y": 0 },
          "targets": [{ "expr": "up{job=\"keeper-metrics\"}", "refId": "A" }],
          "fieldConfig": { "defaults": { "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": 0 }, { "color": "green", "value": 1 }] } }, "overrides": [] }
        },
        {
          "id": 3,
          "title": "Readonly replicas",
          "type": "stat",
          "gridPos": { "h": 4, "w": 8, "x": 16, "y": 0 },
          "targets": [{ "expr": "ClickHouseMetrics_ReadonlyReplica", "refId": "A" }]
        },
        {
          "id": 4,
          "title": "Queries (ClickHouseMetrics_Query)",
          "type": "timeseries",
          "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
          "targets": [{ "expr": "ClickHouseMetrics_Query", "legendFormat": "{{ '{{' }} instance {{ '}}' }}", "refId": "A" }]
        },
        {
          "id": 5,
          "title": "Replica delay",
          "type": "timeseries",
          "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
          "targets": [{ "expr": "ClickHouseAsyncMetrics_ReplicasMaxAbsoluteDelay", "legendFormat": "{{ '{{' }} instance {{ '}}' }}", "refId": "A" }]
        }
      ],
      "refresh": "10s",
      "schemaVersion": 39,
      "tags": ["clickhouse", "lab"],
      "templating": { "list": [] },
      "time": { "from": "now-15m", "to": "now" },
      "timezone": "browser",
      "title": "ClickHouse lab",
      "uid": "clickhouse-lab",
      "version": 1
    }
