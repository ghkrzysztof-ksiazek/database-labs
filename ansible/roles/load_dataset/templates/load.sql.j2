CREATE DATABASE IF NOT EXISTS nyc ON CLUSTER '{{ cluster_name }}';

CREATE TABLE IF NOT EXISTS nyc.trips ON CLUSTER '{{ cluster_name }}'
(
    trip_id UInt32,
    vendor_id String,
    pickup_date Date,
    pickup_datetime DateTime,
    dropoff_date Date,
    dropoff_datetime DateTime,
    store_and_fwd_flag UInt8,
    rate_code_id UInt8,
    pickup_longitude Float64,
    pickup_latitude Float64,
    dropoff_longitude Float64,
    dropoff_latitude Float64,
    passenger_count UInt8,
    trip_distance Float64,
    fare_amount Float32,
    extra Float32,
    mta_tax Float32,
    tip_amount Float32,
    tolls_amount Float32,
    ehail_fee Float32,
    improvement_surcharge Float32,
    total_amount Float32,
    payment_type String,
    trip_type UInt8,
    pickup String,
    dropoff String,
    cab_type String,
    pickup_nyct2010_gid Int8,
    pickup_ctlabel Float32,
    pickup_borocode Int8,
    pickup_ct2010 String,
    pickup_boroct2010 String,
    pickup_cdeligibil String,
    pickup_ntacode String,
    pickup_ntaname String,
    pickup_puma UInt16,
    dropoff_nyct2010_gid UInt8,
    dropoff_ctlabel Float32,
    dropoff_borocode UInt8,
    dropoff_ct2010 String,
    dropoff_boroct2010 String,
    dropoff_cdeligibil String,
    dropoff_ntacode String,
    dropoff_ntaname String,
    dropoff_puma UInt16
)
ENGINE = ReplicatedMergeTree('/clickhouse/tables/{uuid}/{shard}', '{replica}')
PARTITION BY toYYYYMM(pickup_date)
ORDER BY (pickup_datetime, trip_id);

CREATE TABLE IF NOT EXISTS nyc.trips_dist ON CLUSTER '{{ cluster_name }}'
AS nyc.trips
ENGINE = Distributed('{{ cluster_name }}', nyc, trips, cityHash64(trip_id));

INSERT INTO nyc.trips
SELECT
    coalesce(trip_id, 0),
    coalesce(toString(vendor_id), ''),
    coalesce(pickup_date, toDate(0)),
    coalesce(pickup_datetime, toDateTime(0)),
    coalesce(dropoff_date, toDate(0)),
    coalesce(dropoff_datetime, toDateTime(0)),
    coalesce(store_and_fwd_flag, 0),
    coalesce(rate_code_id, 0),
    coalesce(pickup_longitude, 0),
    coalesce(pickup_latitude, 0),
    coalesce(dropoff_longitude, 0),
    coalesce(dropoff_latitude, 0),
    coalesce(passenger_count, 0),
    toFloat64OrZero(toString(trip_distance)),
    toFloat32OrZero(toString(fare_amount)),
    toFloat32OrZero(toString(extra)),
    toFloat32OrZero(toString(mta_tax)),
    toFloat32OrZero(toString(tip_amount)),
    coalesce(tolls_amount, 0),
    coalesce(ehail_fee, 0),
    toFloat32OrZero(toString(improvement_surcharge)),
    toFloat32OrZero(toString(total_amount)),
    coalesce(payment_type, ''),
    coalesce(trip_type, 0),
    coalesce(pickup, ''),
    coalesce(dropoff, ''),
    coalesce(cab_type, ''),
    coalesce(pickup_nyct2010_gid, 0),
    coalesce(pickup_ctlabel, 0),
    coalesce(pickup_borocode, 0),
    coalesce(pickup_ct2010, ''),
    coalesce(pickup_boroct2010, ''),
    coalesce(pickup_cdeligibil, ''),
    coalesce(pickup_ntacode, ''),
    coalesce(pickup_ntaname, ''),
    coalesce(pickup_puma, 0),
    coalesce(dropoff_nyct2010_gid, 0),
    coalesce(dropoff_ctlabel, 0),
    coalesce(dropoff_borocode, 0),
    coalesce(dropoff_ct2010, ''),
    coalesce(dropoff_boroct2010, ''),
    coalesce(dropoff_cdeligibil, ''),
    coalesce(dropoff_ntacode, ''),
    coalesce(dropoff_ntaname, ''),
    coalesce(dropoff_puma, 0)
FROM s3('{{ nyc_taxi_url }}', NOSIGN, 'TabSeparatedWithNames');
