grafana:
  adminPassword: {{ grafana_admin_password }}
  service:
    type: NodePort
    nodePort: 30300
  resources:
    requests:
      cpu: 50m
      memory: 128Mi
    limits:
      memory: 512Mi

alertmanager:
  service:
    type: NodePort
    nodePort: 30093
  alertmanagerSpec:
    resources:
      requests:
        cpu: 20m
        memory: 64Mi
      limits:
        memory: 256Mi
  config:
    global:
      resolve_timeout: 5m
{% if slack_webhook_url | length > 0 %}
      slack_api_url: {{ slack_webhook_url | to_json }}
{% endif %}
    route:
      receiver: "{{ 'slack' if slack_webhook_url | length > 0 else 'noop' }}"
      group_by:
        - alertname
        - namespace
      group_wait: 30s
      group_interval: 5m
      repeat_interval: 2h
      routes:
        - matchers:
            - severity =~ "warning|critical"
          receiver: "{{ 'slack' if slack_webhook_url | length > 0 else 'noop' }}"
    receivers:
      - name: noop
{% if slack_webhook_url | length > 0 %}
      - name: slack
        slack_configs:
          - send_resolved: true
            channel: {{ slack_channel | to_json }}
            username: clickhouse-lab
            icon_emoji: ":clickhouse:"
            title: "{% raw %}[{{ .Status | toUpper }}{{ if eq .Status \"firing\" }}:{{ .Alerts.Firing | len }}{{ end }}] {{ .CommonLabels.alertname }}{% endraw %}"
            text: "{% raw %}{{ range .Alerts }}*{{ .Annotations.summary }}*\n{{ .Annotations.description }}\n*Severity:* {{ .Labels.severity }}\n{{ end }}{% endraw %}"
            color: '{% raw %}{{ if eq .Status "firing" }}danger{{ else }}good{{ end }}{% endraw %}'
{% endif %}
    inhibit_rules:
      - source_matchers:
          - severity = critical
        target_matchers:
          - severity = warning
        equal:
          - alertname
          - namespace

prometheus:
  service:
    type: NodePort
    nodePort: 30091
  prometheusSpec:
    retention: 2d
    resources:
      requests:
        cpu: 100m
        memory: 256Mi
      limits:
        memory: 1Gi
    serviceMonitorSelectorNilUsesHelmValues: false
    podMonitorSelectorNilUsesHelmValues: false
    ruleSelectorNilUsesHelmValues: false
    serviceMonitorNamespaceSelector: {}
    ruleNamespaceSelector: {}

prometheusOperator:
  resources:
    requests:
      cpu: 50m
      memory: 128Mi

kubeEtcd:
  enabled: false
kubeControllerManager:
  enabled: false
kubeScheduler:
  enabled: false
