flowchart LR
  subgraph k8s["kind cluster mysql-lab / namespace mysql"]
    OP["ps-operator<br/>1.2.0"]
    subgraph cluster["PerconaServerMySQL lab"]
      P["lab-mysql-0<br/>source, read_only=0"]
      R["lab-mysql-1<br/>replica, read_only=1"]
      BS["lab-binlog-server-0<br/>registers as a replica<br/>serverId 1001"]
    end
    JOB["xb-* Job<br/>percona-xtrabackup 8.4"]
    MINIO[("MinIO<br/>mysql-lab-backups<br/>mysql-lab-binlogs")]
  end
  USER["PerconaServerMySQLBackup"] --> OP
  OP -- "creates" --> JOB
  JOB -- "xtrabackup --stream" --> MINIO
  JOB -. "reads datadir of<br/>source or sourcePod" .-> P
  JOB -. "or the replica" .-> R
  P -- "binlog dump stream" --> BS
  BS -- "checkpoint every 30s / 16M" --> MINIO
